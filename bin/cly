#!/usr/bin/env bash
# cly — one command in front of every coding agent on the machine.
#
# A bare `cly` offers a menu of agents; `cly --resume` lists the sessions of
# all of them, newest first, and reopens the one you pick where it was born;
# `-x` adds the agent's own skip-the-prompts flag. A profile pins an executable,
# standing flags and a launch directory under a name, so `cly claude` starts
# Claude Code where its memories live whatever directory you are standing in.
#
# Claude Code keys its memory store off the directory it was launched from:
#
#     ~/.claude/projects/<launch-dir-with-separators-mangled>/memory/
#
# There is one store per directory, so launching from anywhere else loads none
# of those memories. Nothing errors; the first symptom is Claude not knowing
# something you are certain you told it. cly pins the directory so that cannot
# happen by accident, and pins one for every other tool you run the same way.
#
# The grammar, since v3.0.0:
#
#     cly [OPTION...] [PROFILE|.] [AGENT-ARG...]
#
# The first word is always cly's; everything after the profile name is always
# the agent's. Neither can claim the other's flags, which is why nothing here
# needs a --cly- prefix.
#
# This is the whole program. bash, MSYS2 and WSL run it directly; PowerShell
# and cmd reach it through the cly.cmd shim beside it. Install with install.sh.
#
# It deliberately uses shell builtins and mkdir and nothing else: the shim may
# hand it a bash whose PATH carries no sed, awk or cygpath, and a config file
# of key=value lines is not worth a dependency on any of them. The session
# lists are read the same way — from each agent's own index file, never from
# the transcripts, which cost a disk open each and can number in the hundreds.
# That takes bash 4.2 or later (associative arrays, printf's %()T): every
# Linux, Git for Windows and MSYS2 has one; macOS ships 3.2 and needs brew's.

set -u

if [ "${BASH_VERSINFO[0]}" -lt 4 ] || { [ "${BASH_VERSINFO[0]}" = 4 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; }; then
    echo "cly: needs bash 4.2 or later, and this is bash $BASH_VERSION" >&2
    exit 2
fi

CLY_VERSION=4.0.0

# Print a here-doc without cat, which is not a builtin: the .cmd door may hand
# this script a bash whose PATH carries no coreutils at all, and one of these
# is in the path that writes the config file.
cly_emit() {
    local line
    while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line"; done
}

# Offered as the default answer when the profile being set up runs Claude Code.
# Skipping permissions is no longer part of it: that is what -x is for.
CLY_CLAUDE_FLAGS='--remote-control'

# What a v2 config with no flags= line meant, and still means: v2 had no -x,
# so taking the bypass out of it would change a launch nobody edited. -x sees
# the flag already there and adds nothing.
CLY_V2_FLAGS='--remote-control --dangerously-skip-permissions'

# A profile may not take one of these names: the first word means these first.
CLY_RESERVED='. init config help version'

# Field separator inside a session row. Never appears in a path or a prompt.
CLY_US=$'\x1f'

cly_config_path() { printf '%s\n' "${CLY_CONFIG:-$HOME/.config/cly/config}"; }

# --- config ------------------------------------------------------------------

cfg_exists=0
cfg_default=''
cfg_profiles=''
cfg_real_profiles=''
cfg_legacy=0
cfg_legacy_dir=''
cfg_legacy_flags=''
cfg_legacy_has_flags=0
cfg_default_synth=0

# The keys of the one profile being asked about. Which one that is is known
# before the file is read, so a single pass can both list every name and pick
# up the values of the one that matters.
cly_want_profile=''
prof_bin=''
prof_flags=''
prof_dir=''
prof_kind=''
prof_env=''
prof_has_section=0
prof_has_flags=0
prof_has_dir=0

cly_config_load() {
    local f line rest name key val
    f=$(cly_config_path)
    if [ ! -r "$f" ]; then
        [ -e "$f" ] && echo "cly: $f cannot be read — ignoring it" >&2
        return 0
    fi
    cfg_exists=1
    while IFS= read -r line || [ -n "$line" ]; do
        # A config hand-edited in a Windows editor comes back with CRLF, and a
        # trailing \r in a directory name is invisible and fatal.
        line=${line%$'\r'}
        case $line in
            # Comments go first, so the examples the file ships with are not
            # read back as real profiles.
            '#'*) continue ;;
            default=*) cfg_default=${line#default=} ;;
            # A v2 config had these at the top level and no profiles at all.
            # They are read as the definition of a profile called claude,
            # which is what they meant, rather than migrated behind your back.
            dir=*)   cfg_legacy=1; cfg_legacy_dir=${line#dir=} ;;
            flags=*) cfg_legacy=1; cfg_legacy_flags=${line#flags=}; cfg_legacy_has_flags=1 ;;
            profile.*.*=*)
                rest=${line#profile.}
                name=${rest%%.*}
                rest=${rest#*.}
                key=${rest%%=*}
                val=${rest#*=}
                [ -n "$name" ] || continue
                case " $cfg_profiles " in
                    *" $name "*) ;;
                    *) cfg_profiles="${cfg_profiles:+$cfg_profiles }$name" ;;
                esac
                [ "$name" = "$cly_want_profile" ] || continue
                prof_has_section=1
                case $key in
                    bin)   prof_bin=$val ;;
                    flags) prof_flags=$val; prof_has_flags=1 ;;
                    dir)   prof_dir=$val; prof_has_dir=1 ;;
                    kind)  prof_kind=$val ;;
                    env)   prof_env=$val ;;
                esac ;;
        esac
    done < "$f"
}

# A v2 config read as v3 would have written it: dir= and flags= at the top
# level are the definition of a profile called claude, and of the default.
# Nothing is rewritten behind your back; the next `cly init` writes the new
# shape, and until then both work.
cly_config_legacy_fixup() {
    cfg_real_profiles=$cfg_profiles
    [ "$cfg_legacy" = 1 ] || return 0
    case " $cfg_profiles " in
        *" claude "*) ;;
        *) cfg_profiles="claude${cfg_profiles:+ $cfg_profiles}" ;;
    esac
    [ -n "$cfg_default" ] || { cfg_default=claude; cfg_default_synth=1; }
    [ "$cly_want_profile" = claude ] || return 0
    [ "$prof_has_section" = 1 ] && return 0
    prof_has_section=1
    prof_bin=claude
    prof_dir=$cfg_legacy_dir
    prof_has_dir=1
    prof_has_flags=1
    if [ "$cfg_legacy_has_flags" = 1 ]; then
        prof_flags=$cfg_legacy_flags
    else
        # A v2 config with no flags= line meant v2's standing default.
        prof_flags=$CLY_V2_FLAGS
    fi
}

# Which profile `cly .` launches. A single configured profile is the default
# whether or not anybody said so; two without a default= line is a question
# only the user can answer, so it is asked rather than guessed.
#   0 = printed a name · 1 = none configured · 2 = several and none chosen
cly_default_profile() {
    if [ -n "$cfg_default" ]; then printf '%s\n' "$cfg_default"; return 0; fi
    case $cfg_profiles in
        '')    return 1 ;;
        *' '*) return 2 ;;
        *)     printf '%s\n' "$cfg_profiles" ;;
    esac
}

cly_config_header() {
    cly_emit <<'EOF'
# cly configuration
# Written by `cly init`; safe to edit by hand.
#
#   default=NAME              the profile `cly .` launches
#   profile.NAME.bin=EXE      the executable        (default: the profile name)
#   profile.NAME.flags=FLAGS  flags on every launch (default: none)
#   profile.NAME.dir=PATH     where to launch from  (default: here; none = here)
#   profile.NAME.kind=KIND    which agent this is, for -x and --resume
#                             (default: the executable's name)
#   profile.NAME.env=K=V ...  environment to set first; a value of $NAME is
#                             taken from your environment
EOF
}

cly_config_mkdir() {
    local f parent
    f=$(cly_config_path)
    case $f in
        */*) parent=${f%/*}; [ -d "$parent" ] || mkdir -p "$parent" || return 1 ;;
    esac
    if [ ! -e "$f" ]; then
        cly_config_header > "$f" || return 1
    elif [ ! -r "$f" ]; then
        # Never write over a file we were unable to read first.
        echo "cly: $f exists but cannot be read — refusing to overwrite it" >&2
        return 1
    fi
}

# Write one profile where it already sits, or at the end if it is new, and
# leave every other line — comments, other profiles, anything hand-added —
# exactly where it was. The profile's own lines that setup does not ask about
# (kind, env, anything newer than this script) are kept in place too. A KIND
# replaces the old one; an empty KIND keeps it; a KIND of - drops it, for when
# the executable it described has been changed.
cly_config_put_profile() {  # NAME BIN FLAGS DIR [KIND]
    local name=$1 bin=$2 flags=$3 dir=$4 kind=${5:-} f line rest key wrote=0
    local -a out=()
    f=$(cly_config_path)
    cly_config_mkdir || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        case $line in
            "profile.$name."*)
                if [ "$wrote" = 0 ]; then
                    wrote=1
                    out+=("profile.$name.bin=$bin")
                    out+=("profile.$name.flags=$flags")
                    out+=("profile.$name.dir=$dir")
                    case $kind in ''|-) ;; *) out+=("profile.$name.kind=$kind") ;; esac
                fi
                rest=${line#profile.$name.}
                key=${rest%%=*}
                case $key in
                    bin|flags|dir) ;;
                    kind) [ -n "$kind" ] || out+=("$line") ;;
                    *) out+=("$line") ;;
                esac ;;
            *) out+=("$line") ;;
        esac
    done < "$f"
    if [ "$wrote" = 0 ]; then
        out+=('')
        out+=("profile.$name.bin=$bin")
        out+=("profile.$name.flags=$flags")
        out+=("profile.$name.dir=$dir")
        case $kind in ''|-) ;; *) out+=("profile.$name.kind=$kind") ;; esac
    fi
    printf '%s\n' "${out[@]}" > "$f"
}

# Set default=NAME, in place if the line is there, above the profiles if not.
cly_config_put_default() {  # NAME
    local name=$1 f line wrote=0
    local -a out=()
    f=$(cly_config_path)
    cly_config_mkdir || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        case $line in
            default=*)
                [ "$wrote" = 0 ] && { out+=("default=$name"); wrote=1; } ;;
            profile.*)
                if [ "$wrote" = 0 ]; then
                    out+=("default=$name"); out+=(''); wrote=1
                fi
                out+=("$line") ;;
            *) out+=("$line") ;;
        esac
    done < "$f"
    [ "$wrote" = 1 ] || out+=("default=$name")
    printf '%s\n' "${out[@]}" > "$f"
}

# Called before a *new* profile is added: if the one already there was the
# default only by being alone — or only by being the v2 lines — say so in the
# file before it stops being alone.
cly_pin_implicit_default() {  # NAME-BEING-ADDED
    [ -z "$cfg_default" ] || [ "$cfg_default_synth" = 1 ] || return 0
    [ -n "$cfg_profiles" ] || return 0
    case " $cfg_profiles " in *" $1 "*) return 0 ;; esac
    case $cfg_profiles in *' '*) return 0 ;; esac
    cly_config_put_default "$cfg_profiles" || return 1
    echo "cly: 'cly .' still launches $cfg_profiles"
}

# --- paths -------------------------------------------------------------------

# C:\Users\me\claude → /c/Users/me/claude, without leaving the shell. Enough
# for comparing and displaying paths; the launch itself goes through
# cly_to_posix, which asks cygpath when there is one. The drive letter is
# lowercased because /C/Users and /c/Users are the same directory and $HOME
# spells it in lowercase, which is what lets a session's directory show as ~.
posix=''
cly_win_to_posix() {  # PATH → posix
    local p=$1 drive rest
    case $p in
        [A-Za-z]:[/\\]*)
            drive=${p%%:*}
            rest=${p#*:}
            posix="/${drive,,}${rest//\\//}" ;;
        *) posix=$p ;;
    esac
}

# Accept a Windows path wherever a path is read. Someone standing in PowerShell
# types C:\Users\me\claude at the prompt, and that has to mean the same
# directory as /c/Users/me/claude does to the bash this script is running in.
cly_to_posix() {
    local p=$1
    case $p in
        [A-Za-z]:[/\\]*)
            if command -v cygpath >/dev/null 2>&1; then
                cygpath -u "$p"
            else
                cly_win_to_posix "$p"
                printf '%s\n' "$posix"
            fi ;;
        *) printf '%s\n' "$p" ;;
    esac
}

# ~ is expanded by the shell that parses it, never by one that receives it in a
# variable, so a typed "~/claude" would otherwise be a literal directory named ~.
cly_expand_tilde() {
    case $1 in
        '~')   printf '%s\n' "$HOME" ;;
        '~/'*) printf '%s\n' "$HOME/${1#'~/'}" ;;
        *)     printf '%s\n' "$1" ;;
    esac
}

# A directory as the config file spells it. Empty, or the word none, means
# "wherever you are standing" — the same answer an empty prompt gives.
cly_config_dir() {
    case $1 in
        ''|none|NONE) ;;
        *) cly_to_posix "$(cly_expand_tilde "$1")" ;;
    esac
}

# The last path component, without a .exe. What a profile's kind defaults to.
cly_basename() {
    local b=${1##*/}
    b=${b##*\\}
    b=${b%.exe}
    printf '%s\n' "${b%.EXE}"
}

# Whether there is a human on the other end to answer a prompt. CLY_ASSUME_TTY
# exists so the suite can exercise the prompts, which have no other way to be
# reached without a terminal.
cly_is_interactive() {
    [ "${CLY_ASSUME_TTY:-0}" = 1 ] && return 0
    [ -t 0 ]
}

cly_is_reserved() {  # NAME
    case " $CLY_RESERVED " in *" $1 "*) return 0 ;; esac
    return 1
}

# --- agents ------------------------------------------------------------------

# What cly knows about each kind of agent: the flag that skips its permission
# prompts, and the words that reopen one of its sessions by id. A profile's
# kind is its executable's name unless profile.NAME.kind says otherwise, which
# is how `ollama launch claude` counts as Claude Code.
CLY_KINDS='claude codex gemini kimi qwen opencode'

# The kinds whose sessions -r can list. Qwen Code and OpenCode keep theirs in
# shapes this script cannot read (a per-directory tree it cannot map back to
# a directory; a database).
CLY_LISTABLE='claude codex gemini kimi'

kind_label=''
kind_bypass=''
kind_resume=''
cly_kind_info() {  # KIND → the three above; 1 if cly has never heard of it
    kind_label='' kind_bypass='' kind_resume=''
    case $1 in
        claude)   kind_label='Claude Code'; kind_bypass=--dangerously-skip-permissions; kind_resume=--resume ;;
        codex)    kind_label='Codex';       kind_bypass=--dangerously-bypass-approvals-and-sandbox; kind_resume=resume ;;
        gemini)   kind_label='Gemini CLI';  kind_bypass=--yolo; kind_resume=--resume ;;
        kimi)     kind_label='Kimi Code';   kind_bypass=--yolo; kind_resume=--session ;;
        qwen)     kind_label='Qwen Code';   kind_bypass=--yolo; kind_resume=--resume ;;
        opencode) kind_label='OpenCode';    kind_bypass=--auto; kind_resume=--session ;;
        *) return 1 ;;
    esac
}

# The menu a bare `cly` offers: every kind above, plus the models that have no
# terminal agent of their own and reach one through Ollama instead. Each entry
# knows how to get itself and how to sign in, so picking one that is not here
# yet prints the two lines that would make it so.
CLY_CATALOG='claude codex gemini kimi qwen opencode deepseek meta'

cat_label=''
cat_bin=''
cat_kind=''
cat_flags=''
cat_install=''
cat_login=''
cly_catalog_info() {  # NAME → the six above; 1 if not in the catalog
    cat_label='' cat_bin='' cat_kind='' cat_flags='' cat_install='' cat_login=''
    case $1 in
        claude)   cat_label='Claude Code'; cat_bin=claude; cat_flags=$CLY_CLAUDE_FLAGS
                  cat_install='npm install -g @anthropic-ai/claude-code'
                  cat_login='claude, then /login' ;;
        codex)    cat_label='Codex'; cat_bin=codex
                  cat_install='npm install -g @openai/codex'
                  cat_login='codex login' ;;
        gemini)   cat_label='Gemini CLI'; cat_bin=gemini
                  cat_install='npm install -g @google/gemini-cli'
                  cat_login='gemini, then pick "Login with Google"' ;;
        kimi)     cat_label='Kimi Code'; cat_bin=kimi
                  cat_install='npm install -g @moonshot-ai/kimi-code'
                  cat_login='kimi, then /login' ;;
        qwen)     cat_label='Qwen Code'; cat_bin=qwen
                  cat_install='npm install -g @qwen-code/qwen-code'
                  cat_login='qwen, then /auth (a key or a coding plan)' ;;
        opencode) cat_label='OpenCode'; cat_bin=opencode
                  cat_install='npm install -g opencode-ai'
                  cat_login='opencode auth login' ;;
        # No terminal agent of its own signs you in with a DeepSeek account.
        # An Ollama account does, and `ollama launch claude` runs Claude Code
        # against one of Ollama's hosted models; everything after the -- is
        # Claude Code's, which is where -x and --resume land.
        deepseek) cat_label='DeepSeek'; cat_bin=ollama; cat_kind=claude
                  cat_flags='launch claude --model deepseek-v4-pro --'
                  cat_install='ollama, from https://ollama.com/download'
                  cat_login='ollama signin' ;;
        # Meta hosts no Llama API any more and no agent signs in with Meta, so
        # Llama runs on this machine: pull the weights once, then the same
        # Claude-Code-through-Ollama route as above.
        meta)     cat_label='Llama'; cat_bin=ollama; cat_kind=claude
                  cat_flags='launch claude --model llama3.1 --'
                  cat_install='ollama, from https://ollama.com/download, then: ollama pull llama3.1'
                  cat_login='none — the model runs here' ;;
        *) return 1 ;;
    esac
    [ -n "$cat_kind" ] || cat_kind=$1
}

cly_is_kind() {  # NAME
    case " $CLY_KINDS " in *" $1 "*) return 0 ;; esac
    return 1
}

cly_is_listable() {  # KIND
    case " $CLY_LISTABLE " in *" $1 "*) return 0 ;; esac
    return 1
}

# --- sessions ----------------------------------------------------------------
#
# Every agent keeps its own store, and every store has an index cheap enough to
# read whole. A session becomes one row — EPOCH KIND ID CWD TITLE, separated by
# CLY_US — and the rows of every agent are merged, sorted and shown together.
# Reading a store is deliberately: one file into a string, split on newlines,
# then parameter expansion. `mapfile` reads 128 bytes at a time and is 25x
# slower on the index sizes measured; a transcript open costs 5–80 ms each, so
# a store that has no index is only opened for the rows that will be shown.
#
# Nothing in here forks. On Windows a $(...) costs 30–80 ms, and the index has
# one line per prompt ever typed, so the small functions below hand their
# answer back in a global (jv, epoch, posix, age, where, title) instead of
# printing it. Measured: the same listing took 38 s with substitutions and
# under a second without.

ses_rows=()
lines=()
jv=''
epoch=0

# How many sessions are shown, and how many files a store without an index
# is allowed to open for them. CLY_ROWS, when it is a number.
cly_rows=30
cly_rows_setting() {
    cly_rows=${CLY_ROWS:-30}
    case $cly_rows in ''|*[!0-9]*|0) cly_rows=30 ;; esac
}

# Split FILE into lines[]: a whole-file read, no loop of reads. Globbing is
# off for the split because a prompt may well contain a *.
cly_read_lines() {  # FILE
    local c
    local IFS=$'\n'
    lines=()
    [ -r "$1" ] || return 1
    c=$(<"$1") || return 1
    set -f
    lines=($c)
    set +f
}

# JSON's backslash escapes, enough of them for a path or a prompt: the pairs
# that appear in practice, done in an order that keeps \\n a backslash and an
# n. Titles are cut short before they get here, so this stays cheap.
cly_json_unescape() {  # TEXT → jv
    local s=$1
    s=${s//\\\\/$'\x01'}
    s=${s//\\\"/\"}
    s=${s//\\n/ }
    s=${s//\\t/ }
    s=${s//\\r/}
    s=${s//\\\//\/}
    jv=${s//$'\x01'/\\}
}

# 2026-08-25T07:50:31.238Z → seconds since the epoch, in the shell. Days from
# civil date after Howard Hinnant; 10# because 08 is not octal. The timestamp
# is taken as UTC whatever follows the seconds: every store read here writes
# a Z, and an offset would only shift an age by hours. Honour it here if a
# store starts writing one.
cly_iso_epoch() {  # ISO → epoch
    local s=$1 y m d H M S era yoe doy doe days
    case $s in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9][:-][0-9][0-9]*) ;;
        *) epoch=0; return 1 ;;
    esac
    y=$((10#${s:0:4})); m=$((10#${s:5:2})); d=$((10#${s:8:2}))
    H=$((10#${s:11:2})); M=$((10#${s:14:2}))
    case ${s:17:2} in [0-9][0-9]) S=$((10#${s:17:2})) ;; *) S=0 ;; esac
    [ "$m" -le 2 ] && y=$((y - 1))
    era=$(( y / 400 ))
    yoe=$(( y - era * 400 ))
    if [ "$m" -gt 2 ]; then doy=$(( (153 * (m - 3) + 2) / 5 + d - 1 ))
    else doy=$(( (153 * (m + 9) + 2) / 5 + d - 1 )); fi
    doe=$(( yoe * 365 + yoe / 4 - yoe / 100 + doy ))
    days=$(( era * 146097 + doe - 719468 ))
    epoch=$(( days * 86400 + H * 3600 + M * 60 + S ))
}

# A timestamp as an agent wrote it — ISO, seconds, or milliseconds — as
# seconds.
cly_epoch() {  # TIMESTAMP → epoch
    case $1 in
        '') epoch=0 ;;
        *[!0-9]*) cly_iso_epoch "$1" ;;
        *) if [ ${#1} -gt 11 ]; then epoch=$(( $1 / 1000 )); else epoch=$1; fi ;;
    esac
}

# The value of KEY in a one-line JSON object, when it is a string: the text
# between the quotes, still escaped. Takes the LAST occurrence, because the
# indexes put their own keys after the user's text, and the user's text can
# only hold the key's name behind a backslash. Pretty-printed JSON has a space
# after the colon; callers close it first (line=${line//\": /\":}).
cly_json_str() {  # KEY LINE → jv; 1 when the key is not there
    local rest run
    rest=${2##*\"$1\":\"}
    [ "$rest" != "$2" ] || { jv=''; return 1; }
    jv=''
    # Up to the first quote that is not escaped: an odd run of backslashes
    # before a quote means the quote is part of the text.
    while :; do
        jv+=${rest%%\"*}
        [ "${rest%%\"*}" != "$rest" ] || break
        rest=${rest#*\"}
        run=${jv##*[!\\]}
        [ $(( ${#run} % 2 )) = 1 ] || break
        jv+=\"
    done
}

# The same for a number.
cly_json_num() {  # KEY LINE → jv; 0 and 1 when the key is not there
    jv=${2##*\"$1\":}
    [ "$jv" != "$2" ] || { jv=0; return 1; }
    jv=${jv%%[,\}]*}
    jv=${jv%%.*}
    case $jv in ''|*[!0-9]*) jv=0; return 1 ;; esac
}

cly_add_row() {  # EPOCH KIND ID CWD TITLE
    ses_rows+=("$1$CLY_US$2$CLY_US$3$CLY_US$4$CLY_US$5")
}

# Claude Code. Every prompt typed into a session is one line of history.jsonl:
# display, timestamp (ms), project (the launch directory) and sessionId. The
# first prompt that was not a slash command is a session's title, the last
# prompt is its age, and a session whose transcript has since been cleaned up
# is not offered.
cly_sessions_claude() {
    local root=${CLAUDE_CONFIG_DIR:-$HOME/.claude} line sid ts text pdir
    local -a order=()
    local -A first any cwd last
    cly_read_lines "$root/history.jsonl" || return 0
    for line in "${lines[@]}"; do
        case $line in *'"sessionId":"'*) ;; *) continue ;; esac
        cly_json_str sessionId "$line"; sid=$jv
        cly_json_num timestamp "$line"; ts=$jv
        if [ -z "${any[$sid]+x}" ]; then
            cly_json_str project "$line"; cly_json_unescape "$jv"; cwd[$sid]=$jv
            any[$sid]=''
            order+=("$sid")
        fi
        last[$sid]=$ts
        [ -z "${first[$sid]+x}" ] || continue
        text=${line#*\"display\":\"}
        text=${text%%\",\"pastedContents\"*}
        text=${text:0:120}
        case $text in
            /*) [ -n "${any[$sid]}" ] || any[$sid]=$text ;;
            *)  first[$sid]=$text ;;
        esac
    done
    for sid in "${order[@]}"; do
        # The transcript lives under the launch directory with every byte that
        # is not a letter or a digit turned into a dash.
        pdir=${cwd[$sid]//[^A-Za-z0-9]/-}
        [ -s "$root/projects/$pdir/$sid.jsonl" ] || continue
        cly_add_row "$(( ${last[$sid]} / 1000 ))" claude "$sid" "${cwd[$sid]}" "${first[$sid]:-${any[$sid]}}"
    done
}

# Codex. history.jsonl has one line per typed prompt — session_id, ts, text —
# and session_index.jsonl the name a thread was given. A session is only there
# to resume while its rollout file is; the launch directory is inside that
# file, so it is read later, for the rows that are shown (cly_session_cwd).
cly_sessions_codex() {
    local root=${CODEX_HOME:-$HOME/.codex} line sid ts text f
    local -a order=()
    local -A first last title rollout
    cly_read_lines "$root/history.jsonl" || return 0
    for line in "${lines[@]}"; do
        case $line in *'"session_id":"'*) ;; *) continue ;; esac
        sid=${line#*\"session_id\":\"}; sid=${sid%%\"*}
        cly_json_num ts "$line"; ts=$jv
        if [ -z "${first[$sid]+x}" ]; then
            text=${line#*\"text\":\"}
            text=${text%\"\}}
            first[$sid]=${text:0:120}
            order+=("$sid")
        fi
        last[$sid]=$ts
    done
    if cly_read_lines "$root/session_index.jsonl"; then
        for line in "${lines[@]}"; do
            sid=${line#*\"id\":\"}; sid=${sid%%\"*}
            cly_json_str thread_name "$line" && title[$sid]=$jv
        done
    fi
    # rollout-2026-08-25T00-50-31-<id>.jsonl: the id is the tail of the name.
    for f in "$root"/sessions/*/*/*/rollout-*.jsonl; do
        [ -e "$f" ] || continue
        sid=${f%.jsonl}; sid=${sid: -36}
        rollout[$sid]=$f
    done
    for sid in "${order[@]}"; do
        [ -n "${rollout[$sid]+x}" ] || continue
        cly_add_row "${last[$sid]}" codex "$sid" '' "${title[$sid]:-${first[$sid]}}"
    done
}

# The N names that sort last, in that order — for files whose name carries
# their date, so the newest can be chosen without a stat each.
newest=()
cly_newest_by_name() {  # N FILE...
    local n=$1 i j best tmp
    shift
    local -a fs=("$@")
    newest=()
    [ "$n" -lt "${#fs[@]}" ] || n=${#fs[@]}
    for ((i = 0; i < n; i++)); do
        best=$i
        for ((j = i + 1; j < ${#fs[@]}; j++)); do
            [[ ${fs[j]##*/} > ${fs[best]##*/} ]] && best=$j
        done
        tmp=${fs[i]}; fs[i]=${fs[best]}; fs[best]=$tmp
    done
    newest=("${fs[@]:0:$n}")
}

# Gemini CLI. One file per session under tmp/<project>/chats/, named by its
# start time, so the newest are known before any is opened. The first lines
# name the session and when it was last touched; the first user message is a
# few lines further. The project directory is a slug of the project's name:
# its .project_root file, or projects.json, says which directory that was.
cly_sessions_gemini() {
    local root=${GEMINI_CLI_HOME:-$HOME/.gemini} f line sid ts start text slug pdir dir i user
    local -a files=()
    local -A slugdir
    for f in "$root"/tmp/*/chats/session-*.json*; do [ -s "$f" ] && files+=("$f"); done
    [ ${#files[@]} -gt 0 ] || return 0
    if cly_read_lines "$root/projects.json"; then
        # "<path>": "<slug>", one pair per line when pretty-printed.
        for line in "${lines[@]}"; do
            line=${line//\": /\":}
            line=${line#"${line%%[!$' \t']*}"}
            case $line in \"*\":\"*\"*) ;; *) continue ;; esac
            dir=${line#\"}; dir=${dir%%\"*}
            slug=${line##*\":\"}; slug=${slug%%\"*}
            cly_json_unescape "$dir"; slugdir[$slug]=$jv
        done
    fi
    cly_newest_by_name "$cly_rows" "${files[@]}"
    for f in "${newest[@]}"; do
        sid=''; ts=''; start=''; text=''; user=0; i=0
        while IFS= read -r line && [ "$i" -lt 60 ]; do
            i=$((i + 1))
            line=${line//\": /\":}
            case $line in *'"kind":"subagent"'*) sid=''; break ;; esac
            if [ -z "$sid" ]; then cly_json_str sessionId "$line" && sid=$jv; fi
            case $line in
                *'"lastUpdated":"'*) cly_json_str lastUpdated "$line" && ts=$jv ;;
                *'"startTime":"'*)   if [ -z "$start" ]; then cly_json_str startTime "$line" && start=$jv; fi ;;
            esac
            if [ -z "$text" ]; then
                case $line in *'"type":"user"'*) user=1 ;; esac
                if [ "$user" = 1 ]; then
                    case $line in
                        *'"text":"'*)    cly_json_str text "$line" && text=$jv ;;
                        *'"content":"'*) cly_json_str content "$line" && text=$jv ;;
                    esac
                fi
            fi
            [ -n "$sid" ] && [ -n "$ts" ] && [ -n "$text" ] && break
        done < "$f"
        [ -n "$sid" ] || continue
        pdir=${f%/chats/*}
        slug=${pdir##*/}
        dir=${slugdir[$slug]:-}
        if [ -r "$pdir/.project_root" ]; then
            IFS= read -r line < "$pdir/.project_root" || true
            [ -n "$line" ] && dir=${line%$'\r'}
        fi
        if [ -z "$ts$start" ]; then
            # session-2026-09-01T12-34-<id>: the file's own name, then.
            start=${f##*/session-}
            start="${start:0:13}:${start:14:2}"
        fi
        cly_epoch "${ts:-$start}"
        cly_add_row "$epoch" gemini "$sid" "$dir" "${text:0:120}"
    done
}

# Kimi Code. session_index.jsonl lists every session and its directory, in
# the order they were made; each session's state.json holds its title, last
# prompt, working directory and last-touched time. The index is read whole
# and only the last few dozen sessions are opened.
cly_sessions_kimi() {
    local root=${KIMI_CODE_HOME:-$HOME/.kimi-code} line sid sdir f title prompt ts cwd i n
    local -a ids=()
    local -A dir dead
    if cly_read_lines "$root/session_index.jsonl"; then
        for line in "${lines[@]}"; do
            cly_json_str sessionId "$line" || continue
            sid=$jv
            case $line in *'"deleted":true'*) dead[$sid]=1; continue ;; esac
            cly_json_str sessionDir "$line" || continue
            cly_json_unescape "$jv"; cly_win_to_posix "$jv"; sdir=$posix
            case $sdir in /*) ;; *) sdir=$root/$sdir ;; esac
            [ -n "${dir[$sid]+x}" ] || ids+=("$sid")
            dir[$sid]=$sdir
        done
    else
        for f in "$root"/sessions/*/*/state.json; do
            [ -s "$f" ] || continue
            sdir=${f%/state.json}
            sid=${sdir##*/}
            ids+=("$sid"); dir[$sid]=$sdir
        done
    fi
    n=${#ids[@]}
    i=$(( n - 2 * cly_rows )); [ "$i" -gt 0 ] || i=0
    for sid in "${ids[@]:$i}"; do
        [ -z "${dead[$sid]+x}" ] || continue
        f=${dir[$sid]}/state.json
        [ -s "$f" ] || continue
        title=''; prompt=''; ts=''; cwd=''; n=0
        while IFS= read -r line && [ "$n" -lt 60 ]; do
            n=$((n + 1))
            line=${line//\": /\":}
            case $line in
                *'"archived":true'*) ts=''; break ;;
                *'"title":"'*)      cly_json_str title "$line" && title=$jv ;;
                *'"lastPrompt":"'*) cly_json_str lastPrompt "$line" && prompt=$jv ;;
                *'"updatedAt":"'*)  cly_json_str updatedAt "$line" && ts=$jv ;;
                *'"updatedAt":'*)   cly_json_num updatedAt "$line" && ts=$jv ;;
                *'"cwd":"'*)        if [ -z "$cwd" ]; then cly_json_str cwd "$line" && cwd=$jv; fi ;;
                *'"workDir":"'*)    if [ -z "$cwd" ]; then cly_json_str workDir "$line" && cwd=$jv; fi ;;
            esac
        done < "$f"
        [ -n "$ts" ] || continue
        cly_epoch "$ts"
        cly_json_unescape "$cwd"
        cly_add_row "$epoch" kimi "$sid" "$jv" "${title:-${prompt:0:120}}"
    done
}

# Where a session was born, for the kinds whose index does not say: found in
# the session's own file, one open per row shown.
cly_session_cwd() {  # KIND ID → jv
    local root f line
    jv=''
    case $1 in
        codex)
            root=${CODEX_HOME:-$HOME/.codex}
            for f in "$root"/sessions/*/*/*/rollout-*-"$2".jsonl; do
                [ -s "$f" ] || continue
                IFS= read -r line < "$f" || true
                cly_json_str cwd "$line" && cly_json_unescape "$jv"
                return 0
            done ;;
    esac
}

cly_sessions_all() {  # [KIND]
    local k
    ses_rows=()
    for k in $CLY_LISTABLE; do
        [ -z "${1:-}" ] || [ "$1" = "$k" ] || continue
        "cly_sessions_$k"
    done
}

# Newest first, all of them. The listers append each store oldest first, so
# the reverse is nearly the order wanted, and an insertion sort on a nearly
# sorted list is linear — no external sort, none needed.
cly_sort_rows() {
    local n=${#ses_rows[@]} i j k key
    local -a r=()
    for ((i = n - 1; i >= 0; i--)); do r+=("${ses_rows[i]}"); done
    for ((i = 1; i < n; i++)); do
        key=${r[i]}; k=${key%%"$CLY_US"*}; j=$(( i - 1 ))
        while [ "$j" -ge 0 ] && [ "${r[j]%%"$CLY_US"*}" -lt "$k" ]; do
            r[j + 1]=${r[j]}; j=$(( j - 1 ))
        done
        r[j + 1]=$key
    done
    ses_rows=(${r[@]+"${r[@]}"})
}

# Bring the N newest rows to the front, in order. Selection, not a full sort:
# the rows behind them are never shown.
cly_top_rows() {  # N
    local n=${#ses_rows[@]} i j best tmp want=$1
    [ "$want" -lt "$n" ] || want=$n
    for ((i = 0; i < want; i++)); do
        best=$i
        for ((j = i + 1; j < n; j++)); do
            [ "${ses_rows[j]%%"$CLY_US"*}" -gt "${ses_rows[best]%%"$CLY_US"*}" ] && best=$j
        done
        if [ "$best" != "$i" ]; then
            tmp=${ses_rows[i]}; ses_rows[i]=${ses_rows[best]}; ses_rows[best]=$tmp
        fi
    done
}

# Take a row apart into row_epoch, row_kind, row_id, row_cwd, row_title.
row_epoch=''; row_kind=''; row_id=''; row_cwd=''; row_title=''
cly_row_fields() {  # ROW
    local r=$1
    row_epoch=${r%%"$CLY_US"*}; r=${r#*"$CLY_US"}
    row_kind=${r%%"$CLY_US"*};  r=${r#*"$CLY_US"}
    row_id=${r%%"$CLY_US"*};    r=${r#*"$CLY_US"}
    row_cwd=${r%%"$CLY_US"*};   r=${r#*"$CLY_US"}
    row_title=$r
}

# "17m ago", "3h ago", "5d ago", then the date.
age=''
cly_age() {  # EPOCH → age
    local now d
    printf -v now '%(%s)T' -1
    d=$(( now - $1 ))
    if   [ "$1" -le 0 ];      then age='?'
    elif [ "$d" -lt 60 ];     then age=now
    elif [ "$d" -lt 3600 ];   then age="$(( d / 60 ))m ago"
    elif [ "$d" -lt 86400 ];  then age="$(( d / 3600 ))h ago"
    elif [ "$d" -lt 604800 ]; then age="$(( d / 86400 ))d ago"
    else printf -v age '%(%b %d)T' "$1"
    fi
}

# A directory as the table shows it: ~ for home, the tail kept when it is cut,
# because the end of a path is the part that tells them apart.
where=''
cly_where() {  # CWD WIDTH → where
    cly_win_to_posix "$1"
    where=$posix
    case $where in
        "$HOME")   where='~' ;;
        "$HOME"/*) where="~${where#"$HOME"}" ;;
    esac
    [ ${#where} -le "$2" ] || where="...${where: -$(( $2 - 3 ))}"
}

title=''
cly_title() {  # TEXT WIDTH → title
    cly_json_unescape "${1:0:$(( $2 + 40 ))}"
    title=${jv:0:$2}
}

# The table. Title last, so a wide character in it misaligns nothing.
cly_print_sessions() {
    local cols=${COLUMNS:-100} wwhere=26 wtitle i n
    n=${#ses_rows[@]}
    [ "$cols" -ge 60 ] || cols=60
    wtitle=$(( cols - 3 - 2 - 8 - 2 - 8 - 2 - wwhere - 2 ))
    printf '  %3s  %-8s  %-8s  %-*s  %s\n' '#' agent last "$wwhere" where title
    for ((i = 0; i < n; i++)); do
        cly_row_fields "${ses_rows[i]}"
        cly_age "$row_epoch"
        cly_where "$row_cwd" "$wwhere"
        cly_title "$row_title" "$wtitle"
        printf '  %3s  %-8s  %-8s  %-*s  %s\n' $(( i + 1 )) "$row_kind" "$age" "$wwhere" "${where:-?}" "$title"
    done
}

# --- help --------------------------------------------------------------------

# "claude (default), codex" — the profiles as a sentence.
cly_profiles_line() {  # DEFAULT-NAME
    local d=$1 n out=''
    # shellcheck disable=SC2086
    for n in $cfg_profiles; do
        [ "$n" = "$d" ] && n="$n (default)"
        out="${out:+$out, }$n"
    done
    printf '%s\n' "$out"
}

# Tier 0: what a bare `cly` prints when there is no terminal to offer the menu
# at. One screen, the commands, and where to look next.
cly_brief() {
    local d
    cly_emit <<'EOF'
cly — one command in front of every coding agent

usage: cly [OPTION...] [PROFILE|.] [AGENT-ARG...]

  cly              pick an agent from a menu (needs a terminal)
  cly .            launch the default profile
  cly NAME         launch the profile called NAME
  cly -r           pick a session of any agent and resume it
  cly -x NAME      launch it with its permission prompts skipped
  cly init [NAME]  set up a profile
  cly config       show what is configured
EOF
    echo
    if [ -n "$cfg_profiles" ]; then
        d=$(cly_default_profile) || d=''
        printf 'profiles: %s\n' "$(cly_profiles_line "$d")"
    else
        echo "No profiles yet — 'cly init' sets the first one up."
    fi
    echo
    echo "Run 'cly help' for more."
}

cly_help() {
    cly_emit <<'EOF'
cly — one command in front of every coding agent

usage: cly [OPTION...] [PROFILE|.] [AGENT-ARG...]
       cly init [NAME] | cly config | cly help | cly version

A profile is a name with an executable, flags and a launch directory of its
own. The first word is always cly's, and everything after the profile name is
always the agent's, so neither can ever claim the other's flags. With no
profile named, cly offers a menu of the agents it knows.

EXAMPLES
  $ cly                       pick an agent from the menu, then launch it
  $ cly .                     launch the default profile
  $ cly -x .                  the same, with its permission prompts skipped
  $ cly -r                    pick a session of any agent, resume it there
  $ cly -x -r codex           resume a codex session, prompts skipped
  $ cly claude --model opus   launch claude; --model opus reaches the agent
  $ cly --dir ~/work codex    launch it somewhere else, this call only
  $ cly init deepseek         set that profile up, or change it

COMMANDS
  init [NAME]  set up a profile; with no NAME, the one `cly .` launches
  config       show what is configured, and what would run
  help         show this help
  version      show the version

OPTIONS
  -x, --bypass    skip the agent's permission prompts, with its own flag
  -r, --resume    list every agent's sessions, newest first, and resume the
                  one picked; with a PROFILE, only that agent's
  -c, --continue  resume the newest session without asking
  -d, --dir DIR   launch from DIR, this call only
      --here      launch from the current directory, this call only
  -h, --help      show this help
  -V, --version   show the version

  Options come before the profile name. `cly --help` is cly's help; `cly NAME
  --help` is the agent's, because after the name nothing is read by cly.

ARGUMENTS
  PROFILE  a configured name, or `.` for the default. Letters, digits, dash
           and underscore only. A name with no profile yet is offered for
           setup when there is a terminal to ask at and cly knows how to run
           it; otherwise it is an error that says what to install.

           Every config line but the name itself is optional:

             default=claude                which profile `.` means
             profile.codex.bin=codex       the executable  (default: the name)
             profile.codex.flags=--search  its flags       (default: none)
             profile.codex.dir=none        where to launch (default: here)
             profile.codex.kind=codex      which agent, for -x and -r
                                           (default: the executable's name)
             profile.codex.env=A=1 B=$B    environment set first; $B is read
                                           from yours

AGENTS
  claude codex gemini kimi  kinds -x knows the flag of and -r reads the
                            sessions of
  qwen opencode             kinds -x knows the flag of; their sessions are
                            in shapes cly cannot read, so -r skips them
  deepseek meta             routes: Claude Code through Ollama, set up from
                            the menu or by `cly init NAME`

  A session is resumed in the directory it was started in, by the profile of
  its kind, or by the bare agent when no profile has that kind.

ENVIRONMENT
  CLY_DIR     launch directory, overriding the profile
  CLY_FLAGS   flags, overriding the profile; empty means none
  CLY_BIN     the executable, overriding the profile
  CLY_CONFIG  config file location (default: ~/.config/cly/config)
  CLY_ROWS    files -r opens per store that has no index: the newest N
              Gemini and Kimi sessions, N Codex directories (default: 30)

FILES
  ~/.config/cly/config      the profiles, and which one the default is
  ~/.claude/history.jsonl   Claude Code's prompt log, read for -r
  ~/.codex/history.jsonl    Codex's, with ~/.codex/session_index.jsonl
  ~/.gemini/tmp/*/chats/    Gemini CLI's sessions, with ~/.gemini/projects.json
  ~/.kimi-code/sessions/    Kimi Code's, with its session_index.jsonl

EXIT STATUS
  0  the agent was launched, or a command did its work
  1  the config file could not be read or written
  2  a usage error, nothing picked, or a profile that could not be set up

SEE ALSO
  https://github.com/BlueRaddish/cly
EOF
}

# --- setting a profile up ----------------------------------------------------

cly_no_answer() {
    echo >&2
    echo "cly: there is nothing here to read an answer from" >&2
    echo "cly: run 'cly init NAME' in a terminal, or write the profile by hand:" >&2
    echo "cly:   $(cly_config_path)" >&2
}

# A profile name is written into a config key and read back by splitting that
# key on its dots, so a name with a dot in it can be written and never read
# again — and the default= line pointing at it takes the whole config with it.
cly_is_valid_name() {  # NAME
    case $1 in
        ''|-*|*[!A-Za-z0-9_-]*) return 1 ;;
    esac
    return 0
}

cly_name_error() {  # NAME
    echo "cly: '$1' cannot be a profile name" >&2
    echo "cly: letters, digits, dash and underscore only, and not a dash first — a dot or" >&2
    echo "cly: an = would split the config line the name is written into, and a leading" >&2
    echo "cly: dash would make it one of cly's options, so it could never be launched" >&2
}

# How a configured directory reads at a prompt.
cly_dir_label() {  # DIR
    case $1 in
        ''|none|NONE) printf 'here\n' ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# Ask what a profile is made of and write it. $1 is the name; $2, if given, is
# printed first to say why the question is being asked at all. The caller loads
# the profile first, so an existing one is *changed* here rather than replaced:
# every question offers what is there now, and Enter keeps it. A name from the
# catalog that has no profile yet starts from the catalog's answers.
cly_setup_profile() {  # NAME [WHY]
    local name=$1 why=${2:-} bin reply flags dir dbin dflags ddir kind=''

    cly_is_valid_name "$name" || { cly_name_error "$name"; return 2; }

    [ -n "$why" ] && { echo "$why"; echo; }

    if [ "$prof_has_section" = 1 ]; then
        dbin=${prof_bin:-$name}
        dflags=$prof_flags
        ddir=$prof_dir
    elif cly_catalog_info "$name"; then
        dbin=$cat_bin
        dflags=$cat_flags
        ddir=''
        [ "$cat_kind" = "$(cly_basename "$cat_bin")" ] || kind=$cat_kind
    else
        dbin=$name
        dflags=''
        ddir=''
    fi

    if [ "$dbin" = "$name" ] && command -v "$name" >/dev/null 2>&1; then
        bin=$name
    else
        echo "  Which executable should '$name' run?"
        if command -v "$dbin" >/dev/null 2>&1 || [ -x "$dbin" ]; then
            echo "  Enter a command or a path."
        else
            echo "  Enter a command or a path; there is no '$dbin' on your PATH."
        fi
        printf '  [%s] > ' "$dbin"
        IFS= read -r reply || { cly_no_answer; return 2; }
        bin=${reply:-$dbin}
        # exec takes a program, not a command line, so `env FOO=1` would be
        # accepted here and then fail at every launch. A path with a space in
        # it is fine, which is why this asks whether it resolves rather than
        # whether it has a space.
        if ! command -v "$bin" >/dev/null 2>&1 && [ ! -x "$bin" ]; then
            case $bin in
                *[[:space:]]*)
                    echo >&2
                    echo "cly: '$bin' is a command with arguments, not a program" >&2
                    echo "cly: name the program here and give the rest at the flags question" >&2
                    return 2 ;;
            esac
        fi
        # A kind only holds while the executable is the one it described:
        # from the catalog, or from the profile as it was.
        if [ "$bin" != "$dbin" ]; then
            kind=''
            [ "$prof_has_section" = 1 ] && [ -n "$prof_kind" ] && kind=-
        fi
        echo
    fi

    echo "  Which flags should $name be given on every launch?"
    echo "  Enter flags, 'none' for no flags, or press Enter to keep the default."
    echo "  (Skipping permission prompts is not a flag to put here: that is 'cly -x'.)"
    printf '  [%s] > ' "${dflags:-none}"
    IFS= read -r reply || { cly_no_answer; return 2; }
    flags=${reply:-$dflags}
    case $flags in none|NONE) flags='' ;; esac

    echo
    case $bin in
        claude|*/claude|claude.exe|*/claude.exe)
            echo "  Claude Code keeps a separate memory store for every directory it is"
            echo "  launched from, so pinning one means the same memories load each time." ;;
    esac
    echo "  Which directory should $name launch from?"
    case $ddir in
        ''|none|NONE) echo "  Enter a path, or press Enter to launch wherever you are standing." ;;
        *)            echo "  Enter a path, 'here' to launch where you stand, or Enter to keep it." ;;
    esac
    printf '  [%s] > ' "$(cly_dir_label "$ddir")"
    IFS= read -r reply || { cly_no_answer; return 2; }
    dir=${reply:-$ddir}
    case $dir in here|HERE|none|NONE) dir='' ;; esac
    echo

    if [ -n "$dir" ]; then
        dir=$(cly_to_posix "$(cly_expand_tilde "$dir")")
        if [ ! -d "$dir" ]; then
            if mkdir -p "$dir" 2>/dev/null; then
                echo "cly: created $dir"
            else
                echo "cly: cannot create $dir" >&2
                return 2
            fi
        fi
        # Store it absolute: a relative path would name a different directory
        # from every directory you later call cly in.
        dir=$(cd "$dir" && pwd) || return 2
    fi

    cly_config_put_profile "$name" "$bin" "$flags" "${dir:-none}" "$kind" || return 1
    echo "cly: profile $name  $bin ${flags:-(no flags)}"
    [ -n "$kind" ] && echo "cly: counts as      $kind, for -x and -r"
    echo "cly: launches in    ${dir:-wherever you are standing}"
    echo "cly: stored in      $(cly_config_path)"
}

# Read the file with one profile in mind. Cheap enough to do per profile, and
# it keeps every caller reading the same globals.
cly_load_profile() {  # NAME
    prof_bin=''; prof_flags=''; prof_dir=''; prof_kind=''; prof_env=''
    prof_has_section=0; prof_has_flags=0; prof_has_dir=0
    cfg_exists=0; cfg_default=''; cfg_profiles=''; cfg_real_profiles=''
    cfg_legacy=0; cfg_legacy_dir=''; cfg_legacy_flags=''; cfg_legacy_has_flags=0
    cfg_default_synth=0
    cly_want_profile=$1
    cly_config_load
    cly_config_legacy_fixup
}

# What the named profile would run, once the environment has had its say.
# Per-call options are applied by the caller, on top of these.
res_bin=''
res_flags=''
res_dir=''
res_kind=''
res_env=''
cly_resolve() {  # NAME
    local name=$1
    if [ -n "${CLY_BIN:-}" ]; then res_bin=$CLY_BIN
    else res_bin=${prof_bin:-$name}
    fi
    # ${VAR+set}, not :-, so that CLY_FLAGS='' means "no flags at all" rather
    # than "fall back to the profile".
    if [ "${CLY_FLAGS+set}" = set ]; then res_flags=$CLY_FLAGS
    elif [ "$prof_has_flags" = 1 ]; then res_flags=$prof_flags
    else res_flags=''
    fi
    if [ -n "${CLY_DIR:-}" ]; then res_dir=$(cly_to_posix "$(cly_expand_tilde "$CLY_DIR")")
    elif [ "$prof_has_dir" = 1 ]; then res_dir=$(cly_config_dir "$prof_dir")
    else res_dir=''
    fi
    # The kind follows the executable the profile names, not CLY_BIN: the
    # suite points CLY_BIN at a stub, and the stub still stands in for claude.
    if [ -n "$prof_kind" ]; then res_kind=$prof_kind
    else res_kind=$(cly_basename "${prof_bin:-$name}")
    fi
    res_env=$prof_env
}

# --- launching ---------------------------------------------------------------

# Everything a launch and a resume have in common: the environment, then exec.
# FLAGS is deliberately unquoted where it is used: it is a list of arguments.
cly_exec() {  # BIN FLAGS ENV ARG...
    local bin=$1 flags=$2 env=$3 kv k v n
    shift 3
    # shellcheck disable=SC2086
    for kv in $env; do
        k=${kv%%=*}; v=${kv#*=}
        case $kv in
            *=*) ;;
            *) echo "cly: env= entry '$kv' is not NAME=VALUE" >&2; return 2 ;;
        esac
        case $k in
            ''|[0-9]*|*[!A-Za-z0-9_]*)
                echo "cly: env= entry '$kv' does not start with a variable name" >&2
                return 2 ;;
        esac
        case $v in
            '$'[A-Za-z_]*) n=${v#\$}; n=${n%%[!A-Za-z0-9_]*}; v=${!n:-} ;;
        esac
        export "$k=$v"
    done
    # shellcheck disable=SC2086
    exec "$bin" $flags "$@"
}

# The one flag -x adds — nothing, when the profile's standing flags already
# carry it. An unknown kind has no flag cly could know.
cly_bypass_flag() {  # PROFILE KIND
    if ! cly_kind_info "$2" || [ -z "$kind_bypass" ]; then
        echo "cly: -x needs to know $1's flag for skipping prompts, and its kind is '$2'" >&2
        echo "cly: known kinds: $CLY_KINDS — set profile.$1.kind=KIND in the config," >&2
        echo "cly: or put the flag in profile.$1.flags= and launch without -x" >&2
        return 2
    fi
    case " $res_flags " in *" $kind_bypass "*) return 0 ;; esac
    printf '%s\n' "$kind_bypass"
}

# --- commands ----------------------------------------------------------------

cly_cmd_init() {  # [NAME]
    local name=$1 reply
    if [ -n "$name" ]; then
        cly_is_reserved "$name" && { cly_reserved_error "$name"; return 2; }
        cly_is_valid_name "$name" || { cly_name_error "$name"; return 2; }
        cly_pin_implicit_default "$name" || return 1
        # Load it first: setup offers the current values, so Enter keeps them.
        cly_load_profile "$name"
        cly_setup_profile "$name" || return $?
        # The first profile in the file is the default without being asked:
        # there is nothing else `.` could mean. A second one never takes the
        # default over silently.
        if [ -z "$cfg_default" ] && [ -z "$cfg_profiles" ]; then
            cly_config_put_default "$name" || return 1
            echo "cly: 'cly .' now launches $name"
        fi
        return 0
    fi

    echo "cly: setting up the profile that 'cly .' launches."
    echo
    echo "  Which tool should 'cly .' launch?"
    echo "  Enter a name — claude, codex, gemini, kimi, whatever you run."
    printf '  [%s] > ' "${cfg_default:-claude}"
    IFS= read -r reply || { cly_no_answer; return 2; }
    reply=${reply%$'
'}
    name=${reply:-${cfg_default:-claude}}
    cly_is_reserved "$name" && { cly_reserved_error "$name"; return 2; }
    cly_is_valid_name "$name" || { cly_name_error "$name"; return 2; }
    echo

    case " $cfg_profiles " in
        *" $name "*)
            cly_config_put_default "$name" || return 1
            echo "cly: 'cly .' now launches $name, which was already configured"
            echo "cly: run 'cly init $name' to change how"
            return 0 ;;
    esac

    cly_setup_profile "$name" || return $?
    cly_config_put_default "$name" || return 1
    echo "cly: 'cly .' now launches $name"
}

cly_reserved_error() {  # NAME
    echo "cly: '$1' is one of cly's own words, not a profile name" >&2
    echo "cly: reserved: $CLY_RESERVED" >&2
}

cly_cmd_config() {  # [NAME]
    local want=$1 d n names
    echo "cly $CLY_VERSION"
    echo "config file:  $(cly_config_path)"
    [ "$cfg_exists" = 1 ] || echo "              (none yet — 'cly init' writes it)"
    if [ "$cfg_legacy" = 1 ]; then
        case " $cfg_real_profiles " in
            *" claude "*) echo "note:         the v2 dir=/flags= lines are superseded by profile.claude" ;;
            *)            echo "note:         reading the v2 dir=/flags= lines as the claude profile" ;;
        esac
    fi
    d=$(cly_default_profile) || d=''
    echo "default:      ${d:-(none yet — 'cly .' will ask)}"
    names=${want:-$cfg_profiles}
    [ -n "$names" ] || { echo "profiles:     (none configured)"; return 0; }
    # shellcheck disable=SC2086
    for n in $names; do
        cly_load_profile "$n"
        cly_resolve "$n"
        echo
        if [ "$prof_has_section" = 1 ]; then echo "profile $n:"
        else echo "profile $n: (not configured)"; fi
        echo "  executable  $res_bin"
        [ -n "${CLY_BIN:-}" ] && echo "              from CLY_BIN, overriding the profile"
        echo "  flags       ${res_flags:-(none)}"
        [ "${CLY_FLAGS+set}" = set ] && echo "              from CLY_FLAGS, overriding the profile"
        echo "  launches in ${res_dir:-(wherever you are standing)}"
        [ -n "${CLY_DIR:-}" ] && echo "              from CLY_DIR, overriding the profile"
        if cly_kind_info "$res_kind"; then
            echo "  kind        $res_kind — -x adds $kind_bypass"
        else
            echo "  kind        $res_kind — not one cly knows, so -x and -r cannot serve it"
        fi
        [ -n "$res_env" ] && echo "  environment $res_env"
    done
    return 0
}

# --- errors ------------------------------------------------------------------

cly_usage() { echo "usage: cly [OPTION...] [PROFILE|.] [AGENT-ARG...]" >&2; }

cly_usage_error() {  # MESSAGE
    echo "cly: $1" >&2
    cly_usage
}

cly_unknown_option() {  # ARG...
    echo "cly: '$1' is not one of cly's options" >&2
    echo "cly: cly's options come before the profile name; the agent's come after it" >&2
    echo "cly: did you mean:  cly . $*" >&2
}

cly_no_profile_error() {  # NAME
    echo "cly: no profile named '$1'" >&2
    echo "cly: profiles: ${cfg_profiles:-(none configured)}" >&2
    if cly_catalog_info "$1" && ! command -v "$cat_bin" >/dev/null 2>&1; then
        echo "cly: $cat_label needs: $cat_install" >&2
        echo "cly: then sign in:    $cat_login" >&2
    fi
    echo "cly: run 'cly init $1' in a terminal to set one up" >&2
}

# --- the menu ----------------------------------------------------------------

# One line per agent: the configured profiles first, in the order the config
# lists them, then every catalog entry without a profile — installed ones can
# be set up on the spot, the rest say how to get them. Sets menu_names[] and
# menu_lines[] side by side.
menu_names=()
menu_lines=()
menu_tints=()
menu_dims=()
cly_menu_build() {  # DEFAULT-NAME
    local d=$1 n label where state line
    menu_names=(); menu_lines=(); menu_tints=(); menu_dims=()
    # shellcheck disable=SC2086
    for n in $cfg_profiles; do
        cly_load_profile "$n"
        cly_resolve "$n"
        if cly_kind_info "$res_kind"; then label=$kind_label; else label=$res_bin; fi
        where=''
        [ -z "$res_dir" ] || cly_where "$res_dir" 40
        [ "$n" = "$d" ] && where="${where:-here}  (default)"
        menu_names+=("$n")
        printf -v line '%-9s %-12s %s' "$n" "$label" "${where:-here}"
        menu_lines+=("$line")
        cly_tint "$res_kind"; menu_tints+=("$tint"); menu_dims+=(0)
    done
    for n in $CLY_CATALOG; do
        case " $cfg_profiles " in *" $n "*) continue ;; esac
        cly_catalog_info "$n"
        if command -v "$cat_bin" >/dev/null 2>&1; then
            if [ "$cat_bin" = "$n" ]; then state='installed, no profile yet'
            else state="through $cat_bin, no profile yet"; fi
        else
            state="not installed: $cat_install"
        fi
        menu_names+=("$n")
        printf -v line '%-9s %-12s %s' "$n" "$cat_label" "$state"
        menu_lines+=("$line")
        cly_tint "$n"; menu_tints+=("$tint")
        if command -v "$cat_bin" >/dev/null 2>&1; then menu_dims+=(0); else menu_dims+=(1); fi
    done
}

# --- the screen ---------------------------------------------------------------
#
# One picker serves the menu and the sessions, after the one Claude Code's
# --resume shows: a list with a bar on the row in hand, arrows to move, / to
# search, digits to jump to a row, Enter to take it, x to take it with the
# prompts skipped, Esc to leave. It is ANSI escapes and `read -n1`, nothing
# outside the shell.
#
# It is drawn the way Ink draws Claude Code's picker: the frame is printed,
# and every redraw moves the cursor back up over it and prints it again, each
# line cleared to its end. No alternate screen, no clear-screen, no absolute
# cursor moves — measured 2026-09-01: through Git's bash in a plain conhost
# window those are not honoured and every frame lands below the last, while
# cursor-up and clear-to-end work there and in Windows Terminal alike. With
# answers piped in (the suite, or `echo 2 | cly -r`) the same keys arrive the
# same way, only nothing is moved or coloured; with no terminal at all the
# list is printed once and nothing is picked.

scr_lines=()     # what each row shows
scr_keys=()      # what each row is called, for the filter
scr_tint=()      # the colour of each row's first column, an SGR number or ''
scr_dim=()       # 1 for a row drawn faint (a tool that is not there)
scr_match=()     # the rows that match the filter, as indexes into the above
scr_rows=24
scr_cols=80
scr_live=0       # 1 when the screen is a terminal that can be drawn on
scr_drawn=0      # lines the last frame took, to move back over
picked_index=-1
key=''

# The terminal's size, asked of the terminal itself: park the cursor in the
# far corner, ask where it is, put it back. Only with a real terminal on both
# ends — under CLY_ASSUME_TTY the reply would be read out of the answers.
cly_screen_size() {
    local reply='' sz=''
    scr_rows=${LINES:-24}; scr_cols=${COLUMNS:-80}
    [ "$scr_live" = 1 ] || return 0
    printf '\e7\e[999;999H\e[6n\e8'
    if IFS= read -rs -d R -t 0.5 reply; then
        reply=${reply##*\[}
        case $reply in
            [0-9]*';'[0-9]*) scr_rows=${reply%%;*}; scr_cols=${reply#*;} ;;
        esac
    elif command -v stty >/dev/null 2>&1; then
        # A terminal that does not answer: ask the tty driver instead. The
        # one fork in the screen, and only on that terminal.
        sz=$(stty size 2>/dev/null) || sz=''
        case $sz in
            [0-9]*' '[0-9]*) scr_rows=${sz%% *}; scr_cols=${sz#* } ;;
        esac
    fi
    [ "$scr_rows" -ge 8 ] || scr_rows=8
    [ "$scr_cols" -ge 40 ] || scr_cols=40
    # CLY_DEBUG=FILE appends what the screen found out about the terminal.
    [ -z "${CLY_DEBUG:-}" ] || printf 'live=%s rows=%s cols=%s reply=[%s] stty=[%s] in=%s out=%s\n' \
        "$scr_live" "$scr_rows" "$scr_cols" "$reply" "$sz" "$([ -t 0 ] && echo y || echo n)" "$([ -t 1 ] && echo y || echo n)" >> "$CLY_DEBUG"
}

# One key, named: up down pgup pgdn home end enter esc bs, or the character.
# An Esc that turns out not to start a sequence is an Esc, and the key that
# followed it is kept for the next call rather than lost.
key_pending=''
cly_read_key() {
    local c r n
    if [ -n "$key_pending" ]; then
        c=$key_pending; key_pending=''
        [ "$c" = $'\n' ] && c=''
    else
        IFS= read -rsn1 c || return 1
    fi
    case $c in
        '')  key=enter ;;
        $'\e')
            key=esc
            IFS= read -rsn1 -t 0.05 r || return 0
            case $r in
                '['|O)
                    IFS= read -rsn1 -t 0.05 r || return 0
                    case $r in
                        A) key=up ;; B) key=down ;; H) key=home ;; F) key=end ;;
                        [0-9])
                            n=$r
                            while IFS= read -rsn1 -t 0.05 c && [ "$c" != '~' ]; do n="$n$c"; done
                            case $n in
                                1|7) key=home ;; 4|8) key=end ;; 5) key=pgup ;; 6) key=pgdn ;;
                                *) key=other ;;
                            esac ;;
                        *) key=other ;;
                    esac ;;
                '') key_pending=$'\n' ;;
                *)  key_pending=$r ;;
            esac ;;
        $'\x7f'|$'\b') key=bs ;;
        $'\x03') key=esc ;;
        *) key=$c ;;
    esac
}

# TEXT cut to fit WIDTH columns → clipped. Anything past Hangul Jamo counts
# double, which is what CJK and most emoji take on a terminal.
clipped=''
cly_clip() {  # TEXT WIDTH
    local s=$1 w=$2 i n ch cp k cw=0
    case $s in
        *[!\ -~]*)
            n=${#s}; clipped=''
            for ((i = 0; i < n; i++)); do
                ch=${s:i:1}
                printf -v cp '%d' "'$ch"
                if [ "$cp" -ge 4352 ]; then k=2; else k=1; fi
                [ $(( cw + k )) -le "$w" ] || break
                clipped+=$ch; cw=$(( cw + k ))
            done ;;
        *) clipped=${s:0:$w} ;;
    esac
}

# One colour per agent, so a mixed list reads at a glance. Plain SGR numbers:
# they are the ones every console has.
tint=''
cly_tint() {  # KIND-OR-NAME → tint
    case $1 in
        claude)   tint=33 ;;   # yellow
        codex)    tint=32 ;;   # green
        gemini)   tint=36 ;;   # cyan
        kimi)     tint=35 ;;   # magenta
        qwen)     tint=34 ;;   # blue
        opencode) tint=37 ;;   # white
        deepseek) tint=96 ;;   # bright cyan
        meta)     tint=94 ;;   # bright blue
        *)        tint='' ;;
    esac
}

# The rows that match the filter: names that start with it first, then any
# row that has it somewhere. Case does not matter.
cly_screen_filter() {  # QUERY
    local q=${1,,} i n=${#scr_lines[@]}
    local -a rest=()
    scr_match=()
    if [ -z "$q" ]; then
        for ((i = 0; i < n; i++)); do scr_match+=("$i"); done
        return 0
    fi
    for ((i = 0; i < n; i++)); do
        case ${scr_keys[i],,} in
            "$q"*) scr_match+=("$i"); continue ;;
        esac
        case ${scr_lines[i],,} in
            *"$q"*) rest+=("$i") ;;
        esac
    done
    scr_match+=(${rest[@]+"${rest[@]}"})
}

# Frame line for the row at position J of the match list, with its colours.
rowtext=''
cly_screen_rowtext() {  # J CUR
    local j=$1 cur=$2 i line pad w col
    w=$(( scr_cols - 1 ))
    i=${scr_match[j]}
    printf -v line '  %3s  %s' $(( i + 1 )) "${scr_lines[i]}"
    cly_clip "$line" "$w"
    if [ "$scr_live" != 1 ]; then
        if [ "$j" = "$cur" ]; then rowtext="> ${clipped#  }"; else rowtext=$clipped; fi
        return 0
    fi
    if [ "$j" = "$cur" ]; then
        printf -v pad '%*s' $(( w - ${#clipped} )) ''
        rowtext=$'\e[7;1m'"> ${clipped#  }$pad"$'\e[0m'
    elif [ "${scr_dim[i]:-0}" = 1 ]; then
        rowtext=$'\e[2m'"$clipped"$'\e[0m'
    elif [ -n "${scr_tint[i]:-}" ]; then
        # The number, then the first column in its colour.
        col=${clipped:0:7}
        rowtext="$col"$'\e['"${scr_tint[i]}"$'m'"${clipped:7:9}"$'\e[0m'"${clipped:16}"
    else
        rowtext=$clipped
    fi
}

# The title line: the title, and the note and position at the right edge.
titletext=''
cly_screen_titletext() {  # TITLE CUR N NOTE
    local status pad w
    w=$(( scr_cols - 1 ))
    status="$(( $3 > 0 ? $2 + 1 : 0 ))/$3"
    [ -z "$4" ] || status="$4  $status"
    cly_clip "$1" $(( w - ${#status} - 2 ))
    printf -v pad '%*s' $(( w - ${#clipped} - ${#status} )) ''
    if [ "$scr_live" = 1 ]; then titletext=$'\e[1m'"$clipped"$'\e[0m'"$pad"$'\e[2m'"$status"$'\e[0m'
    else titletext="$clipped$pad$status"; fi
}

# Rewrite one line of the frame in place: up to it, print, back down.
cly_screen_line() {  # LINE-INDEX TEXT
    local up=$(( scr_drawn - $1 ))
    printf '\e[%sA\r%s\e[K\e[%sB\r' "$up" "$2" "$up"
}

cly_screen_draw() {  # TITLE HINT HEADER CUR TOP NOTE
    local title=$1 hint=$2 header=$3 cur=$4 top=$5 note=$6
    local out='' j n avail eol='' lines=0 w
    n=${#scr_match[@]}
    avail=$(( scr_rows - 5 ))
    [ "$avail" -ge 1 ] || avail=1
    w=$(( scr_cols - 1 ))
    if [ "$scr_live" = 1 ]; then
        eol=$'\e[K'
        [ "$scr_drawn" -gt 0 ] && out=$'\e['"$scr_drawn"$'A\r'
    fi
    cly_screen_titletext "$title" "$cur" "$n" "$note"
    out+="$titletext$eol"$'\n'; lines=$(( lines + 1 ))
    cly_clip "$hint" "$w"
    if [ "$scr_live" = 1 ]; then out+=$'\e[2m'"$clipped"$'\e[0m'"$eol"$'\n'; else out+="$clipped"$'\n'; fi
    lines=$(( lines + 1 ))
    if [ -n "$header" ]; then
        cly_clip "$header" "$w"
        if [ "$scr_live" = 1 ]; then out+=$'\e[2;4m'"$clipped"$'\e[0m'"$eol"$'\n'; else out+="$clipped"$'\n'; fi
    else
        out+="$eol"$'\n'
    fi
    lines=$(( lines + 1 ))
    for ((j = top; j < top + avail && j < n; j++)); do
        cly_screen_rowtext "$j" "$cur"
        out+="$rowtext$eol"$'\n'
        lines=$(( lines + 1 ))
    done
    if [ "$n" = 0 ]; then out+="  (nothing matches)$eol"$'\n'; lines=$(( lines + 1 )); fi
    [ "$scr_live" = 1 ] && out+=$'\e[J'
    printf '%s' "$out"
    scr_drawn=$lines
}

# Before the rows are built: whether there is a screen, and how wide it is.
cly_screen_open() {
    scr_live=0
    [ -t 0 ] && [ -t 1 ] && scr_live=1
    scr_drawn=0
    cly_screen_size
}

# Leave the way Claude Code's picker leaves: the frame is wiped and the cursor
# is back where the frame began, so what runs next starts on a clean line.
cly_screen_leave() {
    [ "$scr_live" = 1 ] || return 0
    [ "$scr_drawn" -gt 0 ] && printf '\e[%sA\r\e[J' "$scr_drawn"
    printf '\e[?25h'
    scr_drawn=0
    trap - INT TERM
}

# Show scr_lines[] and let one be picked: picked_index is its index, and
# picked_bypass is 1 when it was taken with x rather than Enter. Returns 2
# with nothing picked. START is the row to begin on. Keys, after Claude
# Code's own picker: arrows and the paging keys move, Enter takes the row,
# / starts a search that letters then type into, digits go to a row by number,
# x takes the row with the agent's prompts skipped. Esc steps back one level:
# out of the search (the list stays as the search left it, so x and a number
# work on it), then the search is cleared, then the screen is left. Outside a
# search, letters do nothing — so nothing typed by accident is a command.
picked_index=-1
picked_bypass=0
cly_screen_pick() {  # TITLE HINT HEADER START
    local title=$1 hint=$2 header=$3 cur=${4:-0} top=0 query='' jump='' mode='' n avail
    local note='' hint2 last_top=-1 last_cur=-1 last_n=-1 last_note=''
    local LC_ALL=${LC_ALL:-${LANG:-C.UTF-8}}
    picked_index=-1
    picked_bypass=0
    scr_drawn=0
    if [ "$scr_live" = 1 ]; then
        printf '\e[?25l'
        trap 'cly_screen_leave; exit 130' INT TERM
    fi
    cly_screen_filter ''
    while :; do
        n=${#scr_match[@]}
        avail=$(( scr_rows - 5 )); [ "$avail" -ge 1 ] || avail=1
        [ "$cur" -lt "$n" ] || cur=$(( n - 1 ))
        [ "$cur" -ge 0 ] || cur=0
        [ "$cur" -ge "$top" ] || top=$cur
        [ "$cur" -lt $(( top + avail )) ] || top=$(( cur - avail + 1 ))
        [ "$top" -ge 0 ] || top=0
        if [ "$mode" = search ]; then
            note="/$query"; hint2='type to search · Backspace · Enter take the row · Esc back to the list'
        elif [ -n "$jump" ]; then
            note="row $jump"; hint2=$hint
        else
            note=${query:+/$query}; hint2=$hint
        fi
        if [ "$scr_live" = 1 ] && [ "$scr_drawn" -gt 0 ] && [ "$top" = "$last_top" ] \
                && [ "$n" = "$last_n" ] && [ "$note" = "$last_note" ]; then
            # Only the bar moved: the two rows and the position, not the frame.
            cly_screen_titletext "$title" "$cur" "$n" "$note"
            cly_screen_line 0 "$titletext"
            if [ "$last_cur" != "$cur" ]; then
                cly_screen_rowtext "$last_cur" "$cur"; cly_screen_line $(( 3 + last_cur - top )) "$rowtext"
                cly_screen_rowtext "$cur" "$cur";      cly_screen_line $(( 3 + cur - top )) "$rowtext"
            fi
            last_cur=$cur
        else
            cly_screen_draw "$title" "$hint2" "$header" "$cur" "$top" "$note"
            last_top=$top; last_cur=$cur; last_n=$n; last_note=$note
        fi
        cly_read_key || { cly_screen_leave; return 2; }
        case $key in
            up)      cur=$(( cur - 1 )); continue ;;
            down)    cur=$(( cur + 1 )); continue ;;
            pgup)    cur=$(( cur - avail )); continue ;;
            pgdn)    cur=$(( cur + avail )); continue ;;
            home)    cur=0; continue ;;
            end)     cur=$(( n - 1 )); continue ;;
            enter)
                [ "$n" -gt 0 ] || continue
                picked_index=${scr_match[cur]}
                cly_screen_leave
                return 0 ;;
            other)   continue ;;
        esac
        if [ "$mode" = search ]; then
            case $key in
                esc) mode='' ;;
                bs)  query=${query%?}; cly_screen_filter "$query"; cur=0; top=0 ;;
                ?)   query="$query$key"; cly_screen_filter "$query"; cur=0; top=0 ;;
            esac
            continue
        fi
        case $key in
            esc)
                if [ -n "$query" ]; then query=''; cly_screen_filter ''; cur=0; top=0
                else cly_screen_leave; return 2; fi ;;
            /)    mode=search; jump='' ;;
            x|X)
                [ "$n" -gt 0 ] || continue
                picked_index=${scr_match[cur]}
                picked_bypass=1
                cly_screen_leave
                return 0 ;;
            [0-9])
                jump="$jump$key"
                cur=$(( 10#$jump - 1 )) ;;
            bs)
                jump=${jump%?}
                [ -z "$jump" ] || cur=$(( 10#$jump - 1 )) ;;
        esac
        [ "$cur" -ge 0 ] || cur=0
    done
}

# The menu, and the name chosen in picked. Enter on the first row takes the
# default profile when there is one, which the menu starts on.
picked=''
cly_menu_pick() {  # DEFAULT-NAME
    local d=$1 i n=${#menu_names[@]} start=0
    cly_screen_open
    scr_lines=("${menu_lines[@]}")
    scr_keys=("${menu_names[@]}")
    scr_tint=("${menu_tints[@]}")
    scr_dim=("${menu_dims[@]}")
    for ((i = 0; i < n; i++)); do [ "${menu_names[i]}" = "$d" ] && start=$i; done
    if cly_screen_pick "cly $CLY_VERSION — which agent?" \
            'up/down move · Enter launch · x launch skipping prompts · / search · Esc quit' '' "$start"; then
        picked=${menu_names[picked_index]}
        return 0
    fi
    echo "cly: nothing picked" >&2
    return 2
}

# --- resuming ----------------------------------------------------------------

# List the sessions, let one be picked, and hand the row back in row_*.
# $1 narrows to one kind; $2 = 1 takes the newest without asking. Every
# session is listed; CLY_ROWS only bounds the files opened for the stores
# that keep no index, and the Codex directories read before the screen — the
# rest are read when their row is picked.
cly_pick_session() {  # [KIND] [NO-ASK]
    local kind=${1:-} noask=${2:-0} n i
    cly_rows_setting
    if [ "$noask" != 1 ] && cly_is_interactive; then
        cly_screen_open
        [ "$scr_live" = 1 ] && printf 'cly: reading sessions...\r'
    fi
    cly_sessions_all "$kind"
    n=${#ses_rows[@]}
    if [ "$n" = 0 ]; then
        [ "$scr_live" = 1 ] && printf '\e[K'
        echo "cly: no sessions found${kind:+ for $kind}" >&2
        return 2
    fi
    if [ "$noask" = 1 ]; then
        cly_top_rows 1
        cly_row_fields "${ses_rows[0]}"
        if [ -z "$row_cwd" ]; then cly_session_cwd "$row_kind" "$row_id"; row_cwd=$jv; fi
        return 0
    fi
    cly_sort_rows
    for ((i = 0; i < cly_rows && i < n; i++)); do
        cly_row_fields "${ses_rows[i]}"
        [ -n "$row_cwd" ] && continue
        cly_session_cwd "$row_kind" "$row_id"; row_cwd=$jv
        ses_rows[i]="$row_epoch$CLY_US$row_kind$CLY_US$row_id$CLY_US$row_cwd$CLY_US$row_title"
    done
    if ! cly_is_interactive; then
        echo "cly $CLY_VERSION — which session?${kind:+  ($kind only)}"
        echo
        cly_print_sessions
        echo
        echo "cly: no terminal to pick at — run this in one, or 'cly NAME' with the agent's own resume flag" >&2
        return 2
    fi
    cly_session_lines
    if cly_screen_pick "cly $CLY_VERSION — which session?${kind:+  ($kind only)}" \
            "up/down move · Enter resume · x resume skipping prompts · / search · Esc quit · $n sessions" \
            "$scr_header" 0; then
        cly_row_fields "${ses_rows[picked_index]}"
        if [ -z "$row_cwd" ]; then cly_session_cwd "$row_kind" "$row_id"; row_cwd=$jv; fi
        return 0
    fi
    echo "cly: nothing picked" >&2
    return 2
}

# The table's rows and header as the screen shows them — the same columns as
# cly_print_sessions, without the number, which the screen adds.
scr_header=''
cly_session_lines() {
    local wwhere=26 wtitle i n line
    n=${#ses_rows[@]}
    wtitle=$(( scr_cols - 3 - 2 - 8 - 2 - 8 - 2 - wwhere - 2 ))
    [ "$wtitle" -ge 20 ] || wtitle=20
    printf -v scr_header '  %3s  %-8s  %-8s  %-*s  %s' '#' agent last "$wwhere" where title
    scr_lines=(); scr_keys=(); scr_tint=(); scr_dim=()
    for ((i = 0; i < n; i++)); do
        cly_row_fields "${ses_rows[i]}"
        cly_age "$row_epoch"
        cly_where "$row_cwd" "$wwhere"
        cly_title "$row_title" "$wtitle"
        printf -v line '%-8s  %-8s  %-*s  %s' "$row_kind" "$age" "$wwhere" "${where:-?}" "$title"
        scr_lines+=("$line")
        scr_keys+=("$row_kind")
        cly_tint "$row_kind"; scr_tint+=("$tint"); scr_dim+=(0)
    done
}

# The first profile of a kind, the default first. Empty when there is none.
cly_profile_of_kind() {  # KIND
    local d n
    d=$(cly_default_profile) || d=''
    # shellcheck disable=SC2086
    for n in ${d:+$d} $cfg_profiles; do
        cly_load_profile "$n"
        [ "$prof_has_section" = 1 ] || continue
        cly_resolve "$n"
        [ "$res_kind" = "$1" ] && { printf '%s\n' "$n"; return 0; }
    done
    return 1
}

# --- main --------------------------------------------------------------------

cly_main() {
    local name='' target='' dir='' opt_dir='' opt_here=0 opt_x=0 opt_r=0 opt_c=0
    local rc=0 dir_explicit=0 bypass='' filter='' cwd=''
    local -a agent=()

    # cly's own options, and only before the profile name. Everything after the
    # name is the agent's and is never looked at again.
    while [ $# -gt 0 ]; do
        case $1 in
            -d|--dir)
                if [ $# -lt 2 ]; then
                    cly_usage_error "--dir needs a directory"
                    return 2
                fi
                opt_dir=$2; shift 2 ;;
            --here)       opt_here=1; shift ;;
            -x|--bypass)  opt_x=1; shift ;;
            -r|--resume)  opt_r=1; shift ;;
            -c|--continue) opt_r=1; opt_c=1; shift ;;
            -h|--help)    cly_help; return 0 ;;
            -V|--version) echo "cly $CLY_VERSION"; return 0 ;;
            -*)           cly_unknown_option "$@"; return 2 ;;
            *)            break ;;
        esac
    done

    if [ $# -gt 0 ]; then
        name=$1; shift
        agent=(); [ $# -gt 0 ] && agent=("$@")
    fi

    case $name in
        help)    cly_help; return 0 ;;
        version) echo "cly $CLY_VERSION"; return 0 ;;
        init)
            if [ $# -gt 1 ]; then
                cly_usage_error "init takes one name, and '$2' would be dropped — flags are asked for, not given here"
                return 2
            fi
            cly_load_profile ''
            cly_cmd_init "${1:-}"
            return $? ;;
        config)
            if [ $# -gt 1 ]; then
                cly_usage_error "config takes one name"
                return 2
            fi
            cly_load_profile ''
            target=${1:-}
            if [ "$target" = . ]; then
                target=$(cly_default_profile) || target=''
            fi
            cly_cmd_config "$target"
            return $? ;;
    esac

    cly_load_profile ''

    # -r: the sessions of every agent, or of the named profile's kind. The
    # profile that reopens one is the one named, else the first of that kind,
    # else the bare agent.
    if [ "$opt_r" = 1 ]; then
        if [ "$name" = . ]; then
            name=$(cly_default_profile) || {
                echo "cly: no default profile to narrow -r to" >&2; return 2; }
        fi
        if [ -n "$name" ]; then
            cly_load_profile "$name"
            if [ "$prof_has_section" = 1 ]; then
                cly_resolve "$name"; filter=$res_kind
            elif cly_is_kind "$name"; then
                filter=$name
            else
                cly_no_profile_error "$name"; return 2
            fi
            if ! cly_is_listable "$filter"; then
                echo "cly: $name is of kind '$filter', whose sessions cly cannot read" >&2
                echo "cly: -r lists: $CLY_LISTABLE" >&2
                return 2
            fi
        fi
        cly_pick_session "$filter" "$opt_c" || return $?
        [ "$picked_bypass" = 1 ] && opt_x=1
        cwd=$row_cwd
        # The profile named, if it is one; else the first of the row's kind.
        [ -n "$name" ] && cly_load_profile "$name"
        if [ -z "$name" ] || [ "$prof_has_section" = 0 ]; then
            name=$(cly_profile_of_kind "$row_kind") || name=''
        fi
        if [ -n "$name" ]; then
            cly_load_profile "$name"
            cly_resolve "$name"
        else
            # No profile of that kind: the agent itself, with no standing flags.
            cly_load_profile "$row_kind"
            prof_bin=$row_kind; prof_flags=''; prof_has_flags=1; prof_kind=$row_kind
            prof_env=''; prof_dir=''; prof_has_dir=0
            cly_resolve "$row_kind"
            if ! command -v "$res_bin" >/dev/null 2>&1; then
                echo "cly: that session is $row_kind's, and there is no $row_kind on your PATH" >&2
                return 2
            fi
            name=$row_kind
        fi
        cly_kind_info "$row_kind"
        if [ "$opt_x" = 1 ]; then
            bypass=$(cly_bypass_flag "$name" "$res_kind") || return $?
        fi
        if [ "$opt_here" = 1 ]; then
            dir=''
        elif [ -n "$opt_dir" ]; then
            dir=$(cly_to_posix "$(cly_expand_tilde "$opt_dir")")
            [ -d "$dir" ] || { echo "cly: $dir does not exist" >&2; return 2; }
        else
            dir=${cwd:+$(cly_to_posix "$cwd")}
            if [ -n "$dir" ] && [ ! -d "$dir" ]; then
                echo "cly: the session's directory $dir is gone — resuming in $PWD instead" >&2
                dir=''
            fi
        fi
        [ -n "$dir" ] && { cd "$dir" || return 1; }
        echo "cly: resuming $row_kind session ${row_id:0:8} in ${dir:-$PWD}" >&2
        # shellcheck disable=SC2086
        cly_exec "$res_bin" "$res_flags" "$res_env" ${bypass:+"$bypass"} $kind_resume "$row_id" ${agent[@]+"${agent[@]}"}
    fi

    # No first word: the menu, when there is a terminal to show it at; the
    # brief otherwise, since nothing could be launched without guessing.
    if [ -z "$name" ]; then
        if ! cly_is_interactive; then
            cly_brief
            return 0
        fi
        target=$(cly_default_profile) || target=''
        cly_menu_build "$target"
        cly_load_profile ''
        cly_menu_pick "$target" || return $?
        name=$picked
        [ "$picked_bypass" = 1 ] && opt_x=1
        echo
    fi

    # `.` is whichever profile the config says, or the only one there is.
    if [ "$name" = . ]; then
        target=$(cly_default_profile); rc=$?
        case $rc in
            1)  # Nothing configured at all: this is the first run.
                if cly_is_interactive; then
                    cly_cmd_init '' || return $?
                    echo
                    cly_load_profile ''
                    target=$(cly_default_profile) || return 1
                else
                    echo "cly: no profiles configured, and no terminal to ask at" >&2
                    echo "cly: run 'cly init' in a terminal" >&2
                    return 2
                fi ;;
            2)  echo "cly: several profiles and none of them the default" >&2
                echo "cly: profiles: $cfg_profiles" >&2
                echo "cly: run 'cly init' to choose which one 'cly .' launches" >&2
                return 2 ;;
        esac
        name=$target
    fi

    cly_load_profile "$name"

    # A name with no profile behind it. With a terminal, that is a question;
    # without one, it is an error, because a hook or a cron job cannot answer.
    if [ "$prof_has_section" = 0 ]; then
        if ! cly_is_interactive; then
            cly_no_profile_error "$name"
            return 2
        fi
        if cly_catalog_info "$name"; then
            if ! command -v "$cat_bin" >/dev/null 2>&1; then
                echo "cly: no profile named '$name', and no '$cat_bin' on your PATH" >&2
                echo "cly: $cat_label needs: $cat_install" >&2
                echo "cly: then sign in:    $cat_login" >&2
                echo "cly: after that, 'cly $name' again sets the profile up" >&2
                return 2
            fi
        elif ! command -v "$name" >/dev/null 2>&1; then
            echo "cly: no profile named '$name', and no '$name' on your PATH" >&2
            echo "cly: profiles: ${cfg_profiles:-(none configured)}" >&2
            echo "cly: run 'cly init $name' to make one anyway" >&2
            return 2
        fi
        cly_is_valid_name "$name" || { cly_name_error "$name"; return 2; }
        cly_pin_implicit_default "$name" || return 1
        cly_setup_profile "$name" "cly: no $name profile yet — ${cat_bin:-$name} is on your PATH." || return $?
        if [ -z "$cfg_default" ] && [ -z "$cfg_profiles" ]; then
            cly_config_put_default "$name" || return 1
            echo "cly: 'cly .' now launches $name"
        fi
        echo
        cly_load_profile "$name"
    fi

    cly_resolve "$name"

    if [ "$opt_x" = 1 ]; then
        bypass=$(cly_bypass_flag "$name" "$res_kind") || return $?
    fi

    dir=$res_dir
    dir_explicit=0
    if [ "$opt_here" = 1 ]; then
        dir=''
    elif [ -n "$opt_dir" ]; then
        dir=$(cly_to_posix "$(cly_expand_tilde "$opt_dir")")
        dir_explicit=1
    elif [ -n "${CLY_DIR:-}" ]; then
        dir_explicit=1
    fi

    if [ -n "$dir" ] && [ ! -d "$dir" ]; then
        if [ "$dir_explicit" = 1 ]; then
            # Typed just now, so it is a typo rather than a stale config, and
            # launching in $PWD instead would be the wrong directory silently.
            echo "cly: $dir does not exist" >&2
            return 2
        fi
        # Configured but gone. Worth saying: staying quiet here looks exactly
        # like memories mysteriously failing to load.
        echo "cly: $dir does not exist — launching in $PWD instead" >&2
        echo "cly: run 'cly init $name' to point it somewhere else" >&2
        dir=''
    fi

    [ -n "$dir" ] && { cd "$dir" || return 1; }

    cly_exec "$res_bin" "$res_flags" "$res_env" ${bypass:+"$bypass"} ${agent[@]+"${agent[@]}"}
}

cly_main "$@"
